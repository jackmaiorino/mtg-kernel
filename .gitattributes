* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
.python-version text eol=lf
*.json text eol=lf
*.java text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The canonical deck-source hash contract materializes CRLF before hashing.
*.dek text eol=crlf

# Preserve the pinned DraftZero fixture bytes across Windows checkouts.
data/limited/fdn_v1/*.dck text eol=lf
data/limited/smoke_v1/*.dck text eol=lf

# Preserve the MageZero release's CRLF deck bytes so their SHA-256s match.
data/standard/magezero_v1/decks/*.dck text eol=crlf
